__pycache__/
*.pyc
.venv/
*.db
*.db-wal
*.db-shm
# matter_export writes here by default. The exports are the corpus in text form, so
# they carry exactly what the .db rules above exist to keep out, and *.json cannot be
# blanket-ignored without catching package.json and friends.
exports/

# Source documents. Playbooks, prompt libraries and their spreadsheets are client work
# product and several name the client outright. None are needed to build or test, and
# an accidental `git add -A` is how one reaches a commit that cannot then be unmade.
*.docx
*.doc
*.xlsx
*.xls
*.pdf
*.pptx

# Authoring material that lives outside this repo. The playbook reference is its own
# document with its own life, and the skill belongs with the other skills rather than
# here. requirements/prompt-graph-playbook-rules.md cites both as external sources.
*.skill
requirements/building-legal-playbooks-reference.md
# The authoring references are standalone documents with their own life. Repo docs are
# all named prompt-graph-*.md, so this pattern cannot catch one by accident.
requirements/Building *.md
.pytest_cache/
dist/
.DS_Store
node_modules/
ui/.next/
ui/out/
ui/next-env.d.ts
